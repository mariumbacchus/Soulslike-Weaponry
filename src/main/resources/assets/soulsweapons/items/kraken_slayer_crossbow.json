{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",

    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:crossbow/pull",
      "fallback": {
        "type": "minecraft:model",
        "model": "soulsweapons:item/kraken_slayer_pulling_crossbow"
      },
      "entries": [
        {
          "threshold": 0.58,
          "model": {
            "type": "minecraft:model",
            "model": "soulsweapons:item/kraken_slayer_pull_crossbow_1"
          }
        },
        {
          "threshold": 1.0,
          "model": {
            "type": "minecraft:model",
            "model": "soulsweapons:item/kraken_slayer_pull_crossbow_2"
          }
        }
      ]
    },

    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "soulsweapons:item/kraken_slayer_charged_crossbow"
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "soulsweapons:item/kraken_slayer_charged_crossbow"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "soulsweapons:item/kraken_slayer_crossbow"
      }
    }
  }
}